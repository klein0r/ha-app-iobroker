#!/command/with-contenv bashio
# shellcheck shell=bash
# Oneshot: renders the nginx ingress config from the Go template so that
# nginx listens on the HA-assigned ingress interface and port.

set -euo pipefail

echo "[init-nginx] Generating nginx ingress configuration."

admin_port="$(bashio::config 'admin_port' 2>/dev/null || echo '8081')"
if [[ -z "${admin_port}" ]]; then
    admin_port="8081"
fi

cat > /etc/nginx/includes/upstream.conf << EOF
upstream backend {
    server 127.0.0.1:${admin_port};
}
EOF

bashio::var.json \
    interface "$(bashio::app.ip_address)" \
    port      "^$(bashio::app.ingress_port)" \
    | tempio \
        -template /etc/nginx/templates/ingress.gtpl \
        -out      /etc/nginx/servers/ingress.conf

echo "[init-nginx] Done."
