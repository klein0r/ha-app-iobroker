#!/command/with-contenv bashio
# Oneshot init for the ioBroker Home Assistant add-on.
#
# Ports the relevant parts of the buanet/ioBroker.docker startup script
# (steps 1-4) to the HA add-on world. The longrun service performs step 5
# (running the js-controller).
#
# Key deviations from buanet:
#   * Persistence lives in /data (HA's only persistent path), not /opt.
#     /opt/iobroker is a symlink to /data/iobroker, kept in sync here.
#   * UID/GID are pinned to 1000 in the Dockerfile, so SETUID/SETGID logic
#     is dropped.
#   * Multihost, external DBs, AVAHI, USB chown, userscripts are out of scope
#     for this add-on. Extra apt packages can be installed via the add-on option.

set -euo pipefail

readonly IOB_HOME="/opt/iobroker"
readonly DATA_HOME="/data/iobroker"
readonly INITIAL_TAR="/opt/initial_iobroker.tar"
readonly IOB_WRAPPER="/opt/ha-iobroker/iobroker-wrapper.sh"
readonly IOB_USER="iobroker"
readonly IOB_UID="$(id -u "${IOB_USER}")"
readonly IOB_GID="$(id -g "${IOB_USER}")"
readonly HEALTHCHECK_FILE="/opt/.docker_config/.healthcheck"

log()  { echo "[init-iobroker] $*"; }
fail() { echo "[init-iobroker][ERROR] $*" >&2; exit 1; }

echo "starting" > "${HEALTHCHECK_FILE}"

free_mem="$(awk '/^MemAvailable:/ { printf "%d MiB", $2/1024 }' /proc/meminfo)"
total_mem="$(awk '/^MemTotal:/ { printf "%d MiB", $2/1024 }' /proc/meminfo)"
log "System memory: ${free_mem} free / ${total_mem} total"

disk_info="$(df -h /data 2>/dev/null | awk 'NR==2 { print $4" free / "$2" total ("$5" used)" }' || true)"
if [[ -n "${disk_info}" ]]; then
    log "Disk space (/data): ${disk_info}"
else
    log "Disk space: could not determine (df not permitted or /data not mounted)"
fi

# Install user-requested apt packages before anything else so subsequent steps
# can rely on them being present.
apt-get update -qq
extra_packages="$(bashio::config 'extra_packages | join(" ")' 2>/dev/null || true)"
if [[ -n "${extra_packages}" ]]; then
    log "Installing extra packages: ${extra_packages}"
    # shellcheck disable=SC2086
    apt-get install -y --no-install-recommends ${extra_packages} \
        || log "Warning: some packages could not be installed - non-fatal, continuing."
fi

log "Preparing /data/iobroker layout."

# /opt/iobroker should be a symlink to /data/iobroker. The build-time
# install was tarred into ${INITIAL_TAR}; the directory itself was
# removed in the Dockerfile. Recover from any state where this is not
# true (e.g. an old image variant).
if [[ -e "${IOB_HOME}" && ! -L "${IOB_HOME}" ]]; then
    log "Removing legacy real directory at ${IOB_HOME}."
    rm -rf "${IOB_HOME}"
fi

mkdir -p /data

if [[ ! -L "${IOB_HOME}" ]]; then
    ln -sfn "${DATA_HOME}" "${IOB_HOME}"
fi

# Seed /data/iobroker on first start (or after a /data wipe).
if [[ ! -d "${DATA_HOME}" ]] || [[ -z "$(ls -A "${DATA_HOME}" 2>/dev/null || true)" ]]; then
    [[ -f "${INITIAL_TAR}" ]] || fail "Missing ${INITIAL_TAR} - the image is broken."
    log "Empty /data detected. Seeding fresh ioBroker installation from ${INITIAL_TAR}."
    rm -rf "${DATA_HOME}"
    # Tar entries are "opt/iobroker/..."; strip the "opt/" prefix and land in /data.
    tar -xf "${INITIAL_TAR}" -C /data --strip-components=1
    chown -R "${IOB_UID}:${IOB_GID}" "${DATA_HOME}"
elif [[ -f "${DATA_HOME}/iobroker" ]]; then
    log "Existing ioBroker installation detected in ${DATA_HOME}."
else
    log "Found data in ${DATA_HOME} but no iobroker executable."
    log "If this is not an ioBroker installation, clear the add-on's /data and restart."
    ls -al "${DATA_HOME}" >&2 || true
    fail "Refusing to start - unrecognized ${DATA_HOME} contents."
fi

# Drop the gosu-aware iob wrapper in place. This replaces the upstream
# "iobroker" CLI that uses sudo internally, which fails in containers.
# The original is preserved as iobroker.bak the first time we swap.
if [[ -f "${IOB_WRAPPER}" ]]; then
    if [[ ! -f "${DATA_HOME}/iobroker" ]] || ! cmp -s "${IOB_WRAPPER}" "${DATA_HOME}/iobroker"; then
        log "Installing gosu-aware iobroker CLI wrapper."
        if [[ -f "${DATA_HOME}/iobroker" && ! -f "${DATA_HOME}/iobroker.bak" ]]; then
            cp -a "${DATA_HOME}/iobroker" "${DATA_HOME}/iobroker.bak"
        fi
        install -m 0755 -o "${IOB_UID}" -g "${IOB_GID}" "${IOB_WRAPPER}" "${DATA_HOME}/iobroker"
    fi
fi

# Ensure the iob symlink points directly to the wrapper in the same directory,
# not via the /opt/iobroker indirection left by the installer.
ln -sf "${DATA_HOME}/iobroker" "${DATA_HOME}/iob"
ln -sf "${DATA_HOME}/iobroker" /usr/bin/iobroker
ln -sf "${DATA_HOME}/iobroker" /usr/bin/iob

# Reset ownership inside the data dir. ioBroker is fussy about this and
# bind-mounted volumes commonly come up root-owned.
log "Resetting ownership on ${DATA_HOME} (this can take a moment)."
chown -R "${IOB_UID}:${IOB_GID}" "${DATA_HOME}"

# /opt/.docker_config and /opt/scripts/.docker_config are read by ioBroker's
# own scripts to detect "running inside docker". They live on the image, not
# in /data, so they are recreated automatically on every container start.
chown -R "${IOB_UID}:${IOB_GID}" /opt/.docker_config /opt/scripts/.docker_config 2>/dev/null || true

mkdir -p "${DATA_HOME}/log"
cd "${DATA_HOME}"

# Restore node_modules after a backup that excluded them (backup_exclude: iobroker/node_modules).
# Runs here — after chown and mkdir log — so the iobroker user can write and the log dir exists.
if [[ ! -d "${DATA_HOME}/node_modules" ]]; then
    log "node_modules missing — backup restored without node_modules."
    if [[ -f "${DATA_HOME}/package-lock.json" ]]; then
        log "Restoring exact package versions via 'npm ci' (this may take several minutes)."
        gosu "${IOB_USER}" npm ci --omit=dev --ignore-scripts --prefix "${DATA_HOME}" \
            2>&1 | tee -a "${DATA_HOME}/log/npm_ci_restore.log" \
            || fail "'npm ci' failed — see output above"
        log "npm ci complete."
    else
        log "No package-lock.json found — seeding node_modules from ${INITIAL_TAR}."
        [[ -f "${INITIAL_TAR}" ]] || fail "Missing ${INITIAL_TAR} - the image is broken."
        tar -xf "${INITIAL_TAR}" -C "${DATA_HOME}" \
            --strip-components=2 --wildcards --wildcards-match-slash \
            'opt/iobroker/node_modules/*'
        chown -R "${IOB_UID}:${IOB_GID}" "${DATA_HOME}/node_modules"
        log "node_modules seeded from image tarball."
    fi
fi

log "[DEBUG] Directory contents of ${IOB_HOME}:"
ls -lah "${IOB_HOME}"
log "[DEBUG] Directory contents of ${DATA_HOME}:"
ls -lah "${DATA_HOME}"
log "[DEBUG] PATH:"
echo $PATH

# On a freshly seeded install the tar carries a /opt/iobroker/.fresh_install
# marker. "iob setup first" initialises the JSONL database; we then drop the
# marker so subsequent restarts skip this step.
if [[ -f "${DATA_HOME}/.fresh_install" ]]; then
    log "Fresh install detected - running 'iob setup first'."
    chown "${IOB_UID}:${IOB_GID}" "${DATA_HOME}/log"
    if ! gosu "${IOB_USER}" iob setup first; then
        log "'iob setup first' failed."

        fail "Fresh-install initialisation failed."
    fi

    # Apply default system settings
    gosu "${IOB_USER}" iob object extend system.config '{"common":{"licenseConfirmed":true,"diag":"no-city"}}'

    # Remove host entries from build container
    gosu "${IOB_USER}" iob host remove buildkitsandbox \
        || log "Warning: could not remove old build hostname 'buildkitsandbox' - non-fatal, continuing."

    log "Updating adapter repositories and adapters."
    gosu "${IOB_USER}" iob update
    gosu "${IOB_USER}" iob upgrade all

    rm -f "${DATA_HOME}/.fresh_install"
    log "Fresh-install initialisation complete."
else
    log "Verifying database connection."
    if ! gosu "${IOB_USER}" iob uuid >/dev/null 2>&1; then
        gosu "${IOB_USER}" iob uuid 2>&1 | sed 's/^/[init-iobroker][ERROR] /' >&2 || true
        fail "ioBroker database not reachable - check /data and try again."
    fi
fi

# Apply HA system settings (location, language, currency, site name) to
# ioBroker's system.config on every start when apply_ha_settings=true
# so that a backup restored from another system stays in sync.
if bashio::config.true 'apply_ha_settings' 2>/dev/null; then
    log "Applying system.config values from Home Assistant."
    ha_latitude="52.50"
    ha_longitude="13.40"
    ha_country="Germany"
    ha_language="de"
    ha_currency="EUR"
    ha_site="Home"
    if [[ -n "${SUPERVISOR_TOKEN:-}" ]]; then
        ha_config="$(curl -sf \
            -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
            -H "Content-Type: application/json" \
            http://supervisor/core/api/config 2>/dev/null || true)"
        if [[ -n "${ha_config}" ]]; then
            ha_latitude="$(echo "${ha_config}" | jq -r '.latitude // 52.50')"
            ha_longitude="$(echo "${ha_config}" | jq -r '.longitude // 13.40')"
            ha_country_code="$(echo "${ha_config}" | jq -r '.country // "DE"')"
            ha_country="$(jq -r --arg code "${ha_country_code}" '.["3166-1"][] | select(.alpha_2 == $code) | .name' /usr/share/iso-codes/json/iso_3166-1.json)"
            ha_language_raw="$(echo "${ha_config}" | jq -r '.language // "de"')"
            case "${ha_language_raw,,}" in
                zh-*) ha_language="zh-cn" ;;
                *)    ha_language="${ha_language_raw%%-*}" ;;
            esac
            case "${ha_language}" in
                en|de|ru|pt|nl|fr|it|es|pl|uk|zh-cn) ;;
                *) log "Language '${ha_language}' not supported by ioBroker - falling back to 'en'."; ha_language="en" ;;
            esac
            ha_site="$(echo "${ha_config}" | jq -r '.location_name // "Home"')"
            ha_currency_code="$(echo "${ha_config}" | jq -r '.currency // "EUR"')"
            case "${ha_currency_code}" in
                EUR) ha_currency='€' ;;
                USD) ha_currency='$' ;;
                GBP) ha_currency='£' ;;
                RUB) ha_currency='₽' ;;
                *)   ha_currency="${ha_currency_code}" ;;
            esac
            log "HA config: site=${ha_site}, country=${ha_country}, lat=${ha_latitude}, lon=${ha_longitude}, currency=${ha_currency}, language=${ha_language}"
        else
            log "Warning: could not fetch HA config - using built-in defaults for system.config."
        fi
    else
        log "SUPERVISOR_TOKEN not set - using built-in defaults for system.config."
    fi
    system_config_patch="$(jq -n \
        --argjson lat "${ha_latitude}" \
        --argjson lon "${ha_longitude}" \
        --arg site "${ha_site}" \
        --arg country "${ha_country}" \
        --arg currency "${ha_currency}" \
        --arg language "${ha_language}" \
        '{"common":{"siteName":$site,"country":$country,"longitude":$lon,"latitude":$lat,"currency":$currency,"language":$language}}')"
    gosu "${IOB_USER}" iob object extend system.config "${system_config_patch}" \
        >> "${DATA_HOME}/log/iob_apply_ha_settings.log" 2>&1 \
        || log "Warning: could not apply HA settings to system.config - non-fatal, continuing."
else
    log "apply_ha_settings disabled - skipping system.config sync."
fi

current_host="$(hostname)"
admininstance="$(gosu "${IOB_USER}" iob list instances 2>/dev/null | grep -m1 -oE 'system\.adapter\.admin\.[0-9]+' || true)"

if [[ -z "${admininstance}" ]]; then
    log "No admin instance found - skipping hostname sync."
else
    log "Detected admin instance: ${admininstance}"
    admin_host="$(gosu "${IOB_USER}" iob object get "${admininstance}" --pretty 2>/dev/null | grep -oP '(?<="host": ")[^"]*' || true)"
    log "Recorded admin host: ${admin_host:-<unset>} | container host: ${current_host}"

    if [[ -n "${admin_host}" && "${admin_host}" != "${current_host}" ]]; then
        log "Updating ioBroker hostname from '${admin_host}' to '${current_host}'."
        gosu "${IOB_USER}" iob host "${current_host}"
    fi

    # Sync the admin adapter port with the configured admin_port option so that
    # nginx and ioBroker always agree, even after the user changes the setting.
    admin_port="$(bashio::config 'admin_port' 2>/dev/null || echo '8081')"
    if [[ -z "${admin_port}" ]]; then
        admin_port="8081"
    fi

    log "Setting admin adapter port to ${admin_port}."
    gosu "${IOB_USER}" iob object extend "${admininstance}" "{\"native\":{\"port\":${admin_port}}}" \
        >> "${DATA_HOME}/log/iob_setup_admin_port.log" 2>&1 \
        || log "Warning: could not set admin adapter port - non-fatal, continuing."
fi

# Wire up the ioBroker.hass adapter when running inside Home Assistant.
if bashio::config.true 'install_hass_adapter' 2>/dev/null; then
    # Use iob object get rather than iob list instances: the latter requires a
    # running controller and can return incomplete output during oneshot phase.
    if ! gosu "${IOB_USER}" iob object get system.adapter.hass.99 >/dev/null 2>&1; then
        log "hass adapter instance not found - installing ioBroker.hass.99"
        gosu "${IOB_USER}" iob add hass 99 \
            >> "${DATA_HOME}/log/iob_setup_hass.log" 2>&1 \
            || log "Warning: could not install hass adapter - non-fatal, continuing."
    fi

    if [[ -n "${SUPERVISOR_TOKEN:-}" ]]; then
        log "Changing config of instance hass.99"
        gosu "${IOB_USER}" iob object extend system.adapter.hass.99 '{"common":{"titleLang":"hass (ha-app)"},"native":{"host":"supervisor","port":80,"secure":false}}' \
            >> "${DATA_HOME}/log/iob_setup_hass.log" 2>&1 \
            || log "Warning: could not configure hass.99 - non-fatal, continuing."
    else
        log "Warning: SUPERVISOR_TOKEN not set - hass adapter installed but token not configured."
    fi
else
    log "install_hass_adapter disabled - skipping hass adapter auto-configuration."
fi

# Wire up ioBroker MQTT adapter(s) when enabled.
# Credentials are fetched once from the Supervisor even when both options are
# active, so bashio::services is called at most one time per start.
if bashio::config.true 'install_mqtt_client_adapter' 2>/dev/null || \
   bashio::config.true 'install_mqtt_adapter' 2>/dev/null; then
    if bashio::services.available "mqtt" 2>/dev/null; then
        MQTT_HOST="$(bashio::services mqtt "host")"
        MQTT_PORT="$(bashio::services mqtt "port")"
        MQTT_USER="$(bashio::services mqtt "username")"
        MQTT_PASSWORD="$(bashio::services mqtt "password")"
        MQTT_SSL="$(bashio::services mqtt "ssl")"

        if bashio::config.true 'install_mqtt_client_adapter' 2>/dev/null; then
            if ! gosu "${IOB_USER}" iob object get system.adapter.mqtt-client.99 >/dev/null 2>&1; then
                log "mqtt-client adapter instance not found - installing ioBroker.mqtt-client.99"
                gosu "${IOB_USER}" iob add mqtt-client 99 \
                    >> "${DATA_HOME}/log/iob_setup_mqtt_client.log" 2>&1 \
                    || log "Warning: could not install mqtt-client adapter - non-fatal, continuing."
            fi

            log "Configuring mqtt-client.99 with MQTT broker at ${MQTT_HOST}:${MQTT_PORT}."

            mqtt_client_native_patch="$(jq -n \
                --arg host "${MQTT_HOST}" \
                --argjson port "${MQTT_PORT}" \
                --arg username "${MQTT_USER}" \
                --argjson ssl "${MQTT_SSL}" \
                '{"common":{"enabled":true,"titleLang":"mqtt-client (ha-app)"},"native":{"clientId":"iob-ha-app-mqttclient","host":$host,"port":$port,"username":$username,"ssl":$ssl}}')"

            gosu "${IOB_USER}" iob object extend system.adapter.mqtt-client.99 "${mqtt_client_native_patch}" \
                >> "${DATA_HOME}/log/iob_setup_mqtt_client.log" 2>&1 \
                || log "Warning: could not configure mqtt-client.99 - non-fatal, continuing."

            gosu "${IOB_USER}" iob object set system.adapter.mqtt-client.99 native.password="${MQTT_PASSWORD}" \
                >> "${DATA_HOME}/log/iob_setup_mqtt_client.log" 2>&1 \
                || log "Warning: could not set mqtt-client.99 password - non-fatal, continuing."
        fi

        if bashio::config.true 'install_mqtt_adapter' 2>/dev/null; then
            if ! gosu "${IOB_USER}" iob object get system.adapter.mqtt.99 >/dev/null 2>&1; then
                log "mqtt adapter instance not found - installing ioBroker.mqtt.99"
                gosu "${IOB_USER}" iob add mqtt 99 \
                    >> "${DATA_HOME}/log/iob_setup_mqtt.log" 2>&1 \
                    || log "Warning: could not install mqtt adapter - non-fatal, continuing."
            fi

            log "Configuring mqtt.99 with MQTT broker at ${MQTT_HOST}:${MQTT_PORT}."

            mqtt_native_patch="$(jq -n \
                --arg url "${MQTT_HOST}" \
                --argjson port "${MQTT_PORT}" \
                --arg user "${MQTT_USER}" \
                --argjson ssl "${MQTT_SSL}" \
                '{"common":{"enabled":true,"titleLang":"mqtt (ha-app)"},"native":{"type":"client","clientId":"iob-ha-app-mqtt","url":$url,"port":$port,"user":$user,"ssl":$ssl}}')"

            gosu "${IOB_USER}" iob object extend system.adapter.mqtt.99 "${mqtt_native_patch}" \
                >> "${DATA_HOME}/log/iob_setup_mqtt.log" 2>&1 \
                || log "Warning: could not configure mqtt.99 - non-fatal, continuing."

            gosu "${IOB_USER}" iob object set system.adapter.mqtt.99 native.pass="${MQTT_PASSWORD}" \
                >> "${DATA_HOME}/log/iob_setup_mqtt.log" 2>&1 \
                || log "Warning: could not set mqtt.99 password - non-fatal, continuing."
        fi
    else
        log "MQTT adapter(s) enabled but no MQTT service available - skipping."
    fi
fi

# Grant the iobroker user access to its own s6 service control so that
# maintenance.sh (called by the UpgradeManager as the iobroker user) can
# use s6-svc -d / s6-svc -u without needing root.
# The supervise directory is created by s6-supervise at container start,
# so it exists by the time this oneshot runs.
if [[ -d /run/service/iobroker/supervise ]]; then
    chown root:"${IOB_USER}" /run/service/iobroker/supervise
    chmod 0750               /run/service/iobroker/supervise
    chown root:"${IOB_USER}" /run/service/iobroker/supervise/control
    chmod 0660               /run/service/iobroker/supervise/control
    # s6-svc -wD/-wU uses s6-svlisten (ftrigr_subscribe) internally, which must
    # open the event/ directory for reading. s6-supervise creates it as root:root
    # drwx-ws--T; we hand it to the iobroker group and add group-read so that
    # s6-svlisten can open it without root.
    if [[ -d /run/service/iobroker/event ]]; then
        chown root:"${IOB_USER}" /run/service/iobroker/event
        chmod g+r                /run/service/iobroker/event
    fi
    log "Granted s6 service control access to ${IOB_USER}."
else
    log "Warning: /run/service/iobroker/supervise not found — skipping s6 permission setup."
fi

rm -f "${HEALTHCHECK_FILE}"
log "Init complete - handing off to longrun."
